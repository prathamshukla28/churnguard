# NOTE: reports/ (metrics.json, model_card.md, figures/*.png) is intentionally
# committed so the README renders the charts and numbers on GitHub without a
# reviewer having to run the pipeline.

# OS / editor
.DS_Store
.idea/
.vscode/

# Keep empty dirs
!**/.gitkeep

# Datasets are downloaded, never committed (the Telco CSV is cited, not
# redistributed). `data/*.csv` above covers both real and synthetic files.

